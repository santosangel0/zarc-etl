# Token da API autenticada do INMET (rota /token/estacao/diaria/...).
# Solicitar em https://portal.inmet.gov.br
INMET_TOKEN=

# Diretório raiz para data/raw, data/interim, data/final.
# No container o default é /data (volume montado do host).
# Em dev local, deixe vazio para usar ./data.
DATA_DIR=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
